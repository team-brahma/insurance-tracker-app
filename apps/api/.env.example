# API Application Environment Variables
# Copy to .env and fill in values

# Server
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development

# Database (MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/insurance_tracker"

# JWT — generate your own secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_random_64_char_hex_string
JWT_REFRESH_SECRET=change_me_to_a_different_random_64_char_hex_string
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Firebase Admin SDK (required for push notifications)
# ─────────────────────────────────────────────────────────
# 1. Go to Firebase Console → Project Settings → Service Accounts
# 2. Click "Generate new private key" → downloads a JSON file
# 3. Open that file, copy its ENTIRE contents
# 4. Paste it below as a SINGLE LINE with \n for newlines and \" for quotes
#
# Quick PowerShell command to generate the correct line:
#   $json = Get-Content -Raw -Path "C:\path\to\downloaded.json"
#   $singleLine = $json -replace "`r`n", "\n" -replace "`n", "\n"
#   $escaped = $singleLine -replace '"', '\"'
#   Write-Output "FIREBASE_SERVICE_ACCOUNT_JSON=$escaped"
#
# Then paste the output line below:
